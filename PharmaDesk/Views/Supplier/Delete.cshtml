@model PharmaDesk.Models.Supplier

@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Delete Supplier</h4>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<div class="card p-3" style="max-width: 600px;">
    @if (ViewBag.HasPurchases == true)
    {
        <div class="alert alert-warning">
            <strong>This supplier has purchase records.</strong>
            Deleting is blocked, but the supplier will be <strong>hidden</strong> instead.
        </div>
        <p class="fs-5"><strong>@Model.Name</strong></p>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-warning">Hide instead</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    }
    else
    {
        <p>Are you sure you want to delete this supplier?</p>
        <p class="fs-5"><strong>@Model.Name</strong></p>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    }
</div>