@model PharmaDesk.Models.Supplier

@{
    ViewData["Title"] = "Add Supplier";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Add Supplier</h4>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<div class="card p-3" style="max-width: 600px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Supplier Name *</label>
            <input asp-for="Name" class="form-control" placeholder="e.g. PharmaCo Ltd." />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label">Phone</label>
                <input asp-for="Phone" class="form-control" placeholder="e.g. 0100000000" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Address" class="form-label">Address</label>
                <input asp-for="Address" class="form-control" placeholder="City, street..." />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 mt-3">
            <label asp-for="Notes" class="form-label">Notes</label>
            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Optional notes..."></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}