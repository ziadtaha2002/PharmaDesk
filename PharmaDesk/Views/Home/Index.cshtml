@{
    ViewData["Title"] = "Dashboard";
}

<!-- الكروت العلوية -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 border-primary">
            <div class="text-muted">Today's sales</div>
            <div class="fs-3 fw-bold">$0.00</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3">
            <div class="text-muted">Number of sales</div>
            <div class="fs-3 fw-bold">0</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 border-warning">
            <div class="text-muted">Low stock medicines</div>
            <div class="fs-3 fw-bold">0</div>
        </div>
    </div>
</div>

<!-- جدول قرب انتهاء الصلاحية -->
<div class="card p-3">
    <h5 class="mb-3">Close to expiry (next 90 days)</h5>
    <table class="table table-sm mb-0">
        <thead>
            <tr>
                <th>Medicine</th>
                <th>Batch</th>
                <th>Expires</th>
                <th>Qty</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="4" class="text-muted text-center">No data yet.</td>
            </tr>
        </tbody>
    </table>
</div>