@model IEnumerable<PharmaDesk.Models.Sale>

@{
    ViewData["Title"] = "Sales History";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Sales History</h4>
</div>

<div class="card p-3">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Receipt #</th>
                <th>Date</th>
                <th>Items</th>
                <th class="text-end">Total</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No sales recorded yet.</td>
                </tr>
            }
            @foreach (var sale in Model)
            {
                <tr>
                    <td>@sale.ReceiptNumber</td>
                    <td>@sale.SaleDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@sale.SaleItems.Sum(si => si.Quantity) items</td>
                    <td class="text-end">$@sale.TotalAmount.ToString("0.00")</td>
                    <td class="text-end">
                        <a asp-action="Receipt" asp-route-id="@sale.Id" target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-printer"></i> Print Receipt
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>