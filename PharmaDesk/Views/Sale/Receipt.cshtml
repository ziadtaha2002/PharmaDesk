@model PharmaDesk.Models.Sale

@{
    ViewData["Title"] = "Receipt";
    Layout = null; /* إخفاء القائمة الجانبية في الإيصال */
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Receipt @Model.ReceiptNumber</title>
    <style>
        body { font-family: 'Courier New', Courier, monospace; width: 300px; margin: 0 auto; padding: 20px; font-size: 14px; }
        .text-center { text-align: center; }
        .text-end { text-align: right; }
        .header { border-bottom: 2px dashed #000; padding-bottom: 10px; margin-bottom: 10px; }
        .footer { border-top: 2px dashed #000; padding-top: 10px; margin-top: 10px; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
        th, td { text-align: left; padding: 2px 0; }
        .total-row { font-weight: bold; font-size: 16px; }
    </style>
</head>
<body onload="window.print()">
    <div class="header text-center">
        <h3 style="margin: 0;">PharmaDesk</h3>
        <p style="margin: 5px 0;">Your Health, Our Priority</p>
        <p style="margin: 0;">Receipt: @Model.ReceiptNumber</p>
        <p style="margin: 0;">Date: @Model.SaleDate.ToString("yyyy-MM-dd HH:mm")</p>
        <p style="margin: 0;">Cashier: @Model.TeamMember?.FullName</p>
    </div>

    <table>
        <thead>
            <tr>
                <th>Item</th>
                <th class="text-center">Qty</th>
                <th class="text-end">Price</th>
                <th class="text-end">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.SaleItems)
            {
                <tr>
                    <td>@item.Medicine?.Name</td>
                    <td class="text-center">@item.Quantity</td>
                    <td class="text-end">@item.UnitPrice.ToString("0.00")</td>
                    <td class="text-end">@((item.Quantity * item.UnitPrice).ToString("0.00"))</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="footer">
        <div class="d-flex justify-content-between">
            <span>Total:</span>
            <span class="total-row">$@Model.TotalAmount.ToString("0.00")</span>
        </div>
        <div class="d-flex justify-content-between">
            <span>Payment:</span>
            <span>@Model.PaymentMethod</span>
        </div>
        <p class="text-center" style="margin-top: 15px;">Thank you for your visit!</p>
    </div>
</body>
</html>