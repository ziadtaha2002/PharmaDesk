@model IEnumerable<PharmaDesk.Models.Batch>
@using PharmaDesk.Models

@{
    var medicine = ViewBag.Medicine as Medicine;
    var today = (DateOnly)ViewBag.Today;
    ViewData["Title"] = "Stock Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Batches: @medicine?.Name</h4>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Stock</a>
</div>

<div class="card p-3">
    <table class="table table-sm align-middle mb-0">
        <thead>
            <tr>
                <th>Batch Number</th>
                <th>Expiry Date</th>
                <th class="text-center">Quantity</th>
                <th class="text-end">Cost Price</th>
                <th class="text-center">Status</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No batches recorded for this medicine.</td>
                </tr>
            }
            @foreach (var batch in Model)
            {
                bool isExpired = batch.ExpiryDate <= today;
                <tr class="@(isExpired ? "table-danger" : "")">
                    <td>@batch.BatchNumber</td>
                    <td>@batch.ExpiryDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-center">@batch.QuantityInStock</td>
                    <td class="text-end">$@batch.CostPrice.ToString("0.00")</td>
                    <td class="text-center">
                        @if (isExpired)
                        {
                            <span class="badge bg-danger">Expired</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Valid</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>