@model IEnumerable<PharmaDesk.ViewModels.StockViewModel>

@{
    ViewData["Title"] = "Stock";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Stock</h4>
</div>

<div class="card p-3">
    <table class="table table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th>Medicine</th>
                <th>Generic Name</th>
                <th>Category</th>
                <th class="text-center">Unit</th>
                <th class="text-center">In Stock</th>
                <th class="text-center">Alert Level</th>
                <th class="text-center">Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        No active medicines found. Add medicines first.
                    </td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MedicineName</td>
                    <td>@item.GenericName</td>
                    <td>@item.Category</td>
                    <td class="text-center">@item.Unit</td>
                    <td class="text-center fw-bold @(item.IsLowStock ? "text-warning-custom" : "")">
                        @item.TotalQuantity
                    </td>
                    <td class="text-center">@item.LowStockLevel</td>
                    <td class="text-center">
                        @if (item.IsExpired || item.TotalQuantity == 0)
                        {
                            <span class="badge bg-danger">Out of Stock</span>
                        }
                        else if (item.IsLowStock)
                        {
                            <span class="badge bg-warning text-dark">Low Stock</span>
                        }
                        else
                        {
                            <span class="badge bg-success">In Stock</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.MedicineId" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-list-ul"></i> Batches
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>