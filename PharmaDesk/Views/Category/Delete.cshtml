@model PharmaDesk.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Delete Category</h4>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<div class="card p-3" style="max-width: 600px;">
    @if (ViewBag.HasMedicines == true)
    {
        <div class="alert alert-danger">
            <strong>Cannot delete this category.</strong>
            It contains medicines. Move or delete the medicines first.
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
    }
    else
    {
        <p>Are you sure you want to delete this category?</p>
        <p class="fs-5"><strong>@Model.Name</strong></p>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    }
</div>