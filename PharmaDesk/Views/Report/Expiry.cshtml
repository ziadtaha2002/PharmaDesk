@model IEnumerable<PharmaDesk.Models.Batch>
@using PharmaDesk.Models

@{
    var today = (DateOnly)ViewBag.Today;
    ViewData["Title"] = "Expiry Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Expiry Report</h4>
</div>

<div class="card p-3">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Medicine</th>
                <th>Category</th>
                <th>Batch Number</th>
                <th>Expiry Date</th>
                <th class="text-center">Qty</th>
                <th class="text-center">Status</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        No medicines expiring within 90 days. Great!
                    </td>
                </tr>
            }
            @foreach (var batch in Model)
            {
                bool isExpired = batch.ExpiryDate <= today;
                <tr class="@(isExpired ? "table-danger" : "")">
                    <td>@batch.Medicine?.Name</td>
                    <td>@batch.Medicine?.Category?.Name</td>
                    <td>@batch.BatchNumber</td>
                    <td>@batch.ExpiryDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-center">@batch.QuantityInStock</td>
                    <td class="text-center">
                        @if (isExpired)
                        {
                            <span class="badge bg-danger">Expired</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Expires soon</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>