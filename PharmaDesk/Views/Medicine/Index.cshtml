@model IEnumerable<PharmaDesk.Models.Medicine>

@{
    ViewData["Title"] = "Medicines";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Medicines</h4>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-lg"></i> Add Medicine
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<!-- شريط البحث -->
<div class="card p-3 mb-3">
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="text" name="search" value="@ViewBag.Search"
               class="form-control" placeholder="Search by name, barcode, or generic name..." />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </form>
</div>

<div class="card p-3">
    <table class="table table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Generic</th>
                <th>Barcode</th>
                <th>Category</th>
                <th>Unit</th>
                <th class="text-end">Price</th>
                <th class="text-center">Low Stock</th>
                <th class="text-center">Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">
                        No medicines found.
                    </td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr class="@(item.IsActive ? "" : "text-muted")">
                    <td>@item.Name</td>
                    <td>@item.GenericName</td>
                    <td><code>@item.Barcode</code></td>
                    <td>@item.Category?.Name</td>
                    <td>@item.Unit</td>
                    <td class="text-end">$@item.SellingPrice.ToString("0.00")</td>
                    <td class="text-center">@item.LowStockLevel</td>
                    <td class="text-center">
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Hidden</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                    title="@(item.IsActive ? "Hide" : "Activate")">
                                <i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>