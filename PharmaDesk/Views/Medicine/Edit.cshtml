@model PharmaDesk.ViewModels.MedicineViewModel

@{
    ViewData["Title"] = "Edit Medicine";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Edit Medicine</h4>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<div class="card p-3" style="max-width: 700px;">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label">Brand Name *</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="GenericName" class="form-label">Generic Name</label>
                <input asp-for="GenericName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Barcode" class="form-label">Barcode *</label>
                <input asp-for="Barcode" class="form-control" />
                <span asp-validation-for="Barcode" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label">Category *</label>
                <select asp-for="CategoryId" class="form-select">
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId)">
                            @cat.Name
                        </option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Unit" class="form-label">Unit *</label>
                <select asp-for="Unit" class="form-select">
                    <option value="Box">Box</option>
                    <option value="Strip">Strip</option>
                    <option value="Bottle">Bottle</option>
                    <option value="Tube">Tube</option>
                </select>
                <span asp-validation-for="Unit" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="SellingPrice" class="form-label">Selling Price *</label>
                <input asp-for="SellingPrice" class="form-control" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="SellingPrice" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="LowStockLevel" class="form-label">Low Stock Alert Level</label>
                <input asp-for="LowStockLevel" class="form-control" type="number" min="0" />
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">Update</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}